# Copier en .env.local pour le dev. Sans ces variables, l'app tourne en mode démo local.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Forcer le mode local (tests e2e / démo) : local | supabase
# VITE_DATA_MODE=local
# URL d'un proxy d'import personnalisé (sinon : Edge Function Supabase, ou /api/recipe-import en local)
# VITE_IMPORT_URL=https://exemple.com/recipe-import
