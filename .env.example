# Copier en .env.local pour le dev. Sans ces variables, l'app tourne en mode démo local.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Forcer le mode local (tests e2e / démo) : local | supabase
# VITE_DATA_MODE=local
# URL d'un proxy d'import personnalisé (sinon : Edge Function Supabase, ou /api/recipe-import en local)
# VITE_IMPORT_URL=https://exemple.com/recipe-import
# Détection d'aliments sur photo, en dev / preview uniquement (middleware Vite /api/fridge-scan).
# ⚠ Clé SERVEUR : ne jamais la préfixer VITE_ (elle serait publiée dans le bundle).
# En production, elle se configure en secret Supabase (voir README).
# ANTHROPIC_API_KEY=sk-ant-...
# Vidéos du mode cuisine, en dev / preview uniquement (middleware Vite /api/step-videos). Clé SERVEUR, sans VITE_.
# Sans elle, le mode cuisine s'affiche sans vidéo. En production : secret Supabase (voir README).
# YOUTUBE_API_KEY=
# Option PAYANTE : requêtes YouTube formulées par Claude (ANTHROPIC_API_KEY) au lieu d'être tirées du texte des étapes.
# STEP_VIDEOS_CLAUDE=1
